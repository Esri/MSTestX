<Project>

  <Target Name="SignAssemblies"
          Condition="'$(CertificatePath)' != '' OR '$(MSTESTX_PFX_PASSWORD)' != ''"
          BeforeTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="ComputeIntermediateSatelliteAssemblies">
    <Error Condition="'$(CertificatePath)' == ''"
           Text="CertificatePath is required when MSTESTX_PFX_PASSWORD is supplied." />
    <Error Condition="'$(MSTESTX_PFX_PASSWORD)' == ''"
           Text="The MSTESTX_PFX_PASSWORD environment variable is required when CertificatePath is supplied." />
    <Error Condition="!Exists('$(CertificatePath)')"
           Text="The assembly-signing certificate '$(CertificatePath)' does not exist." />
    <Error Condition="'$(SignToolPath)' == '' OR !Exists('$(SignToolPath)')"
           Text="SignToolPath must point to an existing signtool.exe when assembly signing is enabled." />
    <ItemGroup>
      <FilesToSign Include="@(IntermediateAssembly)" />
      <FilesToSign Include="@(IntermediateRefAssembly)" />
      <FilesToSign Include="@(IntermediateSatelliteAssembliesWithTargetPath)" />
      <FilesToSignFiltered Include="@(FilesToSign)" Condition="Exists(%(FilesToSign.Identity))" />
    </ItemGroup>
    <Exec Condition="'@(FilesToSignFiltered->Count())' > 0"
          Command="pwsh -NoLogo -NoProfile -NonInteractive -Command &quot;&amp; { $password = [Environment]::GetEnvironmentVariable('MSTESTX_PFX_PASSWORD'); &amp; '$(SignToolPath)' sign /v /fd SHA256 /f '$(CertificatePath)' /p $password /tr http://timestamp.digicert.com /td SHA256 '%(FilesToSignFiltered.Identity)'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; &amp; '$(SignToolPath)' verify /pa /all /v '%(FilesToSignFiltered.Identity)'; exit $LASTEXITCODE }&quot;"
          WorkingDirectory="$(ProjectDir)"
          EchoOff="true" />
  </Target>

</Project>
